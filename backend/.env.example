# =============================================================================
# Kingstore SaaS — backend environment template
# Copy to backend/.env and edit. Never commit backend/.env.
# =============================================================================

# --- Flask runtime ---
FLASK_ENV=development                  # development | production | testing
FLASK_DEBUG=1                          # 0 in production
APP_NAME=kingstore-saas
APP_TIMEZONE=Africa/Cairo

# --- Secrets (REQUIRED in production; generate with: python -c "import secrets; print(secrets.token_urlsafe(64))") ---
SECRET_KEY=change-me-in-prod-please
JWT_SECRET_KEY=change-me-in-prod-please-jwt
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Database (PostgreSQL) ---
# Local dev (Postgres on Windows): localhost:5432.
# VPS deploy: container name "db" inside the compose network.
DATABASE_URL=postgresql+psycopg2://kingstore:kingstore@localhost:5432/kingstore
SQLALCHEMY_ECHO=0

# --- Redis (OPTIONAL — leave empty to skip) ---
# Postponed for MVP. Enable when needed for distributed rate-limit / Celery.
REDIS_URL=

# --- Celery (OPTIONAL — leave empty to skip) ---
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- CORS ---
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting ---
# If REDIS_URL is set above, defaults to redis://<that>/3. Otherwise memory://.
# Override here only if you need a custom backend.
RATELIMIT_DEFAULT=200 per minute
# RATELIMIT_STORAGE_URI=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json                        # json | text

# --- File storage (foundation; S3/MinIO migration later) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/app/storage

# --- First-run bootstrap (used by `flask seed bootstrap` once auth module lands) ---
BOOTSTRAP_TENANT_SLUG=kingstore-demo
BOOTSTRAP_TENANT_NAME=Kingstore Demo
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme-on-first-login
